<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#FAF8F2">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MOVIE FINDER" android:textSize="12sp" android:letterSpacing="0.15" android:textColor="#286557" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find your next movie" android:textSize="28sp" android:textStyle="bold" android:textColor="#202B25" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Search titles from the IMDb dataset" android:textSize="14sp" android:textColor="#647069" android:layout_marginTop="6dp" android:layout_marginBottom="20dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/queryInput" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:hint="Movie title" android:inputType="text" android:maxLines="1" android:imeOptions="actionSearch" android:textSize="16sp" android:autofillHints="" />
        <Button android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Search" android:textAllCaps="false" android:backgroundTint="#286557" android:textColor="#FFFFFF" />
    </LinearLayout>
    <RadioGroup android:id="@+id/methodGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/retrofitRadio" android:layout_marginTop="12dp">
        <RadioButton android:id="@+id/retrofitRadio" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Retrofit" />
        <RadioButton android:id="@+id/volleyRadio" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Volley" android:layout_marginStart="20dp" />
    </RadioGroup>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter a movie title to get started" android:textColor="#647069" android:paddingTop="12dp" android:paddingBottom="12dp" android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
